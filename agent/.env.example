# Printly Agent configuration
# Copy to .env and fill in your values

# Printly server URL (production: https://your-domain.com)
PRINTLY_SERVER_URL=http://localhost:3001

# Agent token (generate in Dashboard > Impressão Automática)
PRINTLY_AGENT_TOKEN=

# Printer name (discover with: node list-printers.js)
PRINTLY_PRINTER_NAME=

# Poll interval in milliseconds (default: 5000)
PRINTLY_POLL_INTERVAL=5000
