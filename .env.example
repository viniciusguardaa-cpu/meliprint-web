# Mercado Livre App Credentials
ML_CLIENT_ID=your_client_id
ML_CLIENT_SECRET=your_client_secret
ML_REDIRECT_URI=http://localhost:3001/api/auth/callback

# --- Marketplaces adicionais (cada um aparece na UI só quando configurado) ---

# Shopee Open Platform v2 — app em https://open.shopee.com (aprovação de parceiro)
# Callback registrado: {API_BASE_URL}/api/auth/oauth/shopee/callback
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_API_HOST=https://partner.shopeemobile.com  (BR: https://openplatform.shopee.com.br)

# Bling ERP API v3 — app em https://developer.bling.com.br (homologação necessária)
# BLING_CLIENT_ID=
# BLING_CLIENT_SECRET=

# Magalu Open API — client criado via ID Magalu (id.magalu.com)
# MAGALU_CLIENT_ID=
# MAGALU_CLIENT_SECRET=
# MAGALU_API_BASE=https://api.magalu.com  (sandbox: https://api-sandbox.magalu.com)
# MAGALU_TENANT_ID=  (fallback quando o JWT não traz o tenant)

# Amazon SP-API — app + IAM (roles: Orders, Merchant Fulfillment/Direct-to-Consumer)
# Callback registrado: {API_BASE_URL}/api/auth/oauth/amazon/callback
# AMAZON_APP_ID=
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# AMAZON_AWS_ACCESS_KEY_ID=
# AMAZON_AWS_SECRET_ACCESS_KEY=
# AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
# Ship-from + pacote padrão (Merchant Fulfillment compra o frete ao gerar a etiqueta):
# AMAZON_SHIP_FROM_NAME=
# AMAZON_SHIP_FROM_ADDRESS=
# AMAZON_SHIP_FROM_CITY=
# AMAZON_SHIP_FROM_STATE=
# AMAZON_SHIP_FROM_POSTAL_CODE=
# AMAZON_PKG_LENGTH_CM=20  AMAZON_PKG_WIDTH_CM=15  AMAZON_PKG_HEIGHT_CM=10  AMAZON_PKG_WEIGHT_KG=0.3

# Server
PORT=3001
NODE_ENV=development

# Database (required for production, optional for development)
# Railway provides this automatically when you add a PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/labelgo

# Redis (optional - faster than PostgreSQL for sessions)
# Railway provides this automatically when you add a Redis database
# REDIS_URL=redis://default:password@localhost:6379

# Mercado Pago (for subscriptions)
# Get your credentials at: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=your_mercado_pago_access_token

# Mercado Pago webhook secret (App > Webhooks > "Chave secreta" in the Developer Panel)
# Used to validate that webhook requests really come from Mercado Pago.
# Also remember to configure the webhook URL there (topic: "Assinaturas"):
#   https://your-domain.com/api/subscription/webhook
MP_WEBHOOK_SECRET=your_mercado_pago_webhook_secret

# Sentry (optional - error monitoring)
# Get your DSN at: https://sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Session
SESSION_SECRET=your_session_secret_here

# Encryption key for marketplace tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# REQUIRED in production. In development, an ephemeral dev key is used if missing.
ENCRYPTION_KEY=

# Transactional email (password reset, email verification) via Resend.
# Without RESEND_API_KEY, emails are logged to the server console (dev only).
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=LabelGo <no-reply@labelgo.com.br>

# Base URL used to derive OAuth callback URIs for non-ML providers
# ({API_BASE_URL}/api/auth/oauth/{provider}/callback). ML keeps using
# ML_REDIRECT_URI. Defaults to the origin of ML_REDIRECT_URI.
# API_BASE_URL=http://localhost:3001

# Allow unsigned Mercado Pago webhooks in development (NEVER set in production).
# MP_WEBHOOK_ALLOW_UNSIGNED=1

# Admin panel (used to protect /admin and /api/admin/*)
ADMIN_SECRET=choose_a_strong_random_secret

# Frontend URL (for CORS). Also used as the Mercado Pago back_url — MP rejects
# "localhost" as hostname, so use 127.0.0.1 in dev and browse the app there too
# (the session cookie must be on the same host for the checkout callback).
FRONTEND_URL=http://127.0.0.1:5173
