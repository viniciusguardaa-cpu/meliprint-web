# URL do servidor do Meliprint (produção ou local)
MELIPRINT_SERVER_URL=http://localhost:3001

# Token gerado no painel do Meliprint (Dashboard > Impressão Automática)
MELIPRINT_AGENT_TOKEN=

# Nome exato da impressora no CUPS (descubra com: node list-printers.js)
MELIPRINT_PRINTER_NAME=

# Intervalo de polling em milissegundos (padrão: 5000 = 5s)
MELIPRINT_POLL_INTERVAL=5000
