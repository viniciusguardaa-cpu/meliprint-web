{
  "name": "labelgo-agent",
  "version": "1.2.0",
  "type": "module",
  "description": "LabelGo Agent - impressão automática de etiquetas Mercado Livre e Shopee",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "cli": "node agent.js",
    "list-printers": "node list-printers.js",
    "test-print": "node agent.js --test-print",
    "setup": "node agent.js --setup",
    "check": "node agent.js --check",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "42.11.4",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.labelgo.agent",
    "productName": "LabelGo Agent",
    "asar": true,
    "files": [
      "app/**",
      "lib/**",
      "printers/**",
      "agent.js",
      "list-printers.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "app/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LabelGoAgent-Setup.exe",
      "runAfterFinish": true,
      "shortcutName": "LabelGo Agent"
    },
    "mac": {
      "icon": "app/assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "asarUnpack": [
      "node_modules/pdf-to-printer/dist/**"
    ],
    "appx": {
      "applicationId": "LabelGoAgent",
      "displayName": "LabelGo Agent",
      "identityName": "LabelGo.LabelGo",
      "publisher": "CN=5DB92569-5B1C-439F-B0AC-599EE95F5342",
      "publisherDisplayName": "Label Go",
      "languages": [
        "pt-BR"
      ],
      "backgroundColor": "#ffffff",
      "showNameOnTiles": false,
      "addAutoLaunchExtension": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pdf-to-printer": "5.8.1"
  }
}
