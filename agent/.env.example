# LabelGo Agent configuration
# Copy to .env and fill in your values

# LabelGo server URL (production: https://your-domain.com)
LABELGO_SERVER_URL=http://localhost:3001

# Agent token (generate in Dashboard > Impressão Automática)
LABELGO_AGENT_TOKEN=

# Printer name (discover with: node list-printers.js)
LABELGO_PRINTER_NAME=

# Poll interval in milliseconds (default: 5000)
LABELGO_POLL_INTERVAL=5000
